  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Cult Leader collapses to the ground, blood pooling beneath his body.\nAs
    you triumphantly stand above his corpse, your blood runs out and you lose consciousness.\nYour
    body and soul are agonizingly consumed by a thick red darkness.\nMeanwhile, the
    fall of the Cult Leader destabilizes the ritual he was performing, and the gathered 
    dark magics explode like a collapsing star.\nSearing hot blood floods through
    the cultists\u2019 lair, devouring every person it touches, prisoners and cultists
    alike.\nYou managed to drag the cult down with you, but at what cost?"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
